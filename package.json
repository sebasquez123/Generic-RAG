{
  "name": "phit-api",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.2.1",
  "scripts": {
    "build": "nest build",
    "build:email": "email build --dir=./src/modules/sendgrid/templates",
    "cli": "ts-node -r tsconfig-paths/register src/cli/index.ts",
    "eslint": "eslint \"{src,tests}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx}\" && eslint --fix \"{src,tests}/**/*.{ts,tsx}\"",
    "migration:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource ./src/data-source.ts migration:generate",
    "prepare": "husky install",
    "prettier:check": "prettier --check \"{src,tests}/**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"{src,tests}/**/*.{ts,tsx}\"",
    "recreate-dev-env": "docker compose --project-name=fieldhouse rm -fs && docker compose --project-name=fieldhouse up -d",
    "repl": "npm run start -- --entryFile repl",
    "dev": "nest start --watch",
    "start": "nest start --watch",
    "start:email": "email dev --dir=./src/modules/sendgrid/templates",
    "test": "jest --config jest.config.ts",
    "typecheck": "tsc --project tsconfig.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource ./src/data-source.ts"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.1.48",
    "@langchain/textsplitters": "^1.0.1",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "axios": "^1.6.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudevents": "^1.1.1",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.2",
    "nanoid": "^3.3.7",
    "openid-client": "^5.6.5",
    "pg": "^8.11.5",
    "pino": "^8.20.0",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@types/axios": "^0.14.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.18.8",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.2.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-unicorn": "^52.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "nest-commander": "^3.10.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.3",
    "typescript-eslint": "^7.18.0"
  },
  "overrides": {
    "tsconfig-paths": "^4.2.0"
  }
}
